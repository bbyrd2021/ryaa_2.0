# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# RYAA reads these from the environment at startup (see ryaa/cli.py load_dotenv()).

# --- LLM ---------------------------------------------------------------------
# OpenAI API key (default model is gpt-4o). Required.
OPENAI_API_KEY=sk-...

# --- Google OAuth + Calendar/Tasks -------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials (OAuth client).
# Used for sign-in and per-user Calendar/Tasks access. Required for the API.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Public URL of THIS backend — used to build the OAuth redirect URI
# (<PUBLIC_BASE_URL>/auth/google/callback). Defaults to http://localhost:8000.
PUBLIC_BASE_URL=http://localhost:8000

# --- Secrets -----------------------------------------------------------------
# Signs issued session tokens (JWT). Use a long random string. Required.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string

# Encrypts stored user refresh tokens at rest (Fernet key). Required.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENC_KEY=generate-a-fernet-key

# --- Database ----------------------------------------------------------------
# SQLModel connection string. Defaults to a local SQLite file (sqlite:///ryaa.db).
# DATABASE_URL=postgresql://user:pass@host:5432/ryaa

# --- Voice (optional) --------------------------------------------------------
# ElevenLabs text-to-speech (the /speak endpoint). Optional.
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=your-voice-id

# --- CLI calendar backend (optional) -----------------------------------------
# Local CLI path only: "stub" for tests, otherwise the macOS Apple Calendar.
# The hosted API ignores this and uses per-user Google Calendar.
# RYAA_CALENDAR=stub
