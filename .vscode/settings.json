{
  "python-envs.defaultEnvManager": "ms-python.python:conda",
  "python-envs.defaultPackageManager": "ms-python.python:conda",
  "python-envs.pythonProjects": [],
  "python.defaultInterpreterPath": "/opt/anaconda3/envs/ryaa/bin/python",

  // --- Use the project's TypeScript (frontend/node_modules), not Cursor's bundled one ---
  // Without this, the editor's older TS flags valid options (erasableSyntaxOnly, es2023)
  // as errors even though `tsc -b` passes. Path is relative to this workspace root.
  "typescript.tsdk": "frontend/node_modules/typescript/lib",

  // --- Ruff is the ONE tool for both formatting and linting ---
  "[python]": {
    // Use the Ruff extension (charliermarsh.ruff) as the formatter, so
    // format-on-save runs `ruff format` — the same engine as the CLI.
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      // Auto-fix lint issues (e.g. remove unused imports) on save...
      "source.fixAll.ruff": "explicit",
      // ...and sort imports on save (Ruff's built-in isort).
      "source.organizeImports.ruff": "explicit"
    }
  }
}
